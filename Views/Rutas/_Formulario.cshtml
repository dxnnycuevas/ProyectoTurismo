@model Ruta

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdLugarOrigen" class="form-label">Lugar de origen</label>
        <select asp-for="IdLugarOrigen" class="form-select" asp-items="ViewBag.ListaIdLugarOrigen">
            <option value="">-- Ninguno --</option>
        </select>
        @if (ViewBag.ListaIdLugarOrigen is SelectList listaIdLugarOrigen && !listaIdLugarOrigen.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugarOrigen" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdLugarDestino" class="form-label">Lugar de destino</label>
        <select asp-for="IdLugarDestino" class="form-select" asp-items="ViewBag.ListaIdLugarDestino">
            <option value="">-- Ninguno --</option>
        </select>
        @if (ViewBag.ListaIdLugarDestino is SelectList listaIdLugarDestino && !listaIdLugarDestino.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugarDestino" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="DistanciaKilometros" class="form-label">Distancia (km)</label>
        <input asp-for="DistanciaKilometros" class="form-control" type="number" step="any" />
        <span asp-validation-for="DistanciaKilometros" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="DuracionMinutos" class="form-label">Duración (minutos)</label>
        <input asp-for="DuracionMinutos" class="form-control" type="number" min="0" />
        <span asp-validation-for="DuracionMinutos" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="NivelDificultad" class="form-label">Nivel de dificultad</label>
        <select asp-for="NivelDificultad" class="form-select">
            <option value="">-- Sin especificar --</option>
            <option value="Fácil">Fácil</option>
            <option value="Moderada">Moderada</option>
            <option value="Difícil">Difícil</option>
        </select>
        <span asp-validation-for="NivelDificultad" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="TipoTransporte" class="form-label">Tipo de transporte</label>
        <input asp-for="TipoTransporte" class="form-control" />
        <span asp-validation-for="TipoTransporte" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Instrucciones" class="form-label">Instrucciones</label>
        <textarea asp-for="Instrucciones" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Instrucciones" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Activa" class="form-check-input" />
            <label asp-for="Activa" class="form-check-label">Activa</label>
        </div>
    </div>
</div>
