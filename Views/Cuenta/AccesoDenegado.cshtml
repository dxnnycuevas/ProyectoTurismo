@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h2 class="text-danger mb-3">Acceso denegado</h2>

        @if (RolesSistema.EsPersonal(User))
        {
            <p class="text-muted">No tiene permisos para acceder a esta sección.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            @* Cuenta de visitante: no tiene acceso al panel de administración *@
            <p class="text-muted">Tu cuenta no tiene acceso al panel de administración.</p>
            <a asp-controller="Sitio" asp-action="Index" class="btn btn-primary">Volver al sitio</a>
        }
        else
        {
            <p class="text-muted">No tiene permisos para acceder a esta sección.</p>
            <a asp-controller="Cuenta" asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
        }
    </div>
</div>
