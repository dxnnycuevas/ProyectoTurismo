@model Restaurante
@{
    ViewData["Title"] = "Eliminar restaurante";
}

<h2>Eliminar restaurante</h2>
<hr />

<div class="alert alert-danger">¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de comida</dt>
        <dd class="col-sm-8">@Model.TipoComida</dd>
        <dt class="col-sm-4">Nivel de precio</dt>
        <dd class="col-sm-8">@Formato.NivelPrecio(Model.NivelPrecio)</dd>
        <dt class="col-sm-4">Hora de apertura</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraApertura)</dd>
        <dt class="col-sm-4">Hora de cierre</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraCierre)</dd>
        <dt class="col-sm-4">Servicio a domicilio</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.ServicioDomicilio)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdRestaurante" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
