@model Transporte

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="IdLugar" class="form-label">Lugar</label>
        <select asp-for="IdLugar" class="form-select" asp-items="ViewBag.ListaIdLugar">
            <option value="">-- Seleccione --</option>
        </select>
        @if (ViewBag.ListaIdLugar is SelectList listaIdLugar && !listaIdLugar.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugar" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TipoTransporte" class="form-label">Tipo de transporte</label>
        <input asp-for="TipoTransporte" class="form-control" />
        <span asp-validation-for="TipoTransporte" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ZonaCobertura" class="form-label">Zona de cobertura</label>
        <input asp-for="ZonaCobertura" class="form-control" />
        <span asp-validation-for="ZonaCobertura" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Horario" class="form-label">Horario</label>
        <input asp-for="Horario" class="form-control" />
        <span asp-validation-for="Horario" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="InformacionPrecio" class="form-label">Información de precio</label>
        <input asp-for="InformacionPrecio" class="form-control" />
        <span asp-validation-for="InformacionPrecio" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="RequiereReserva" class="form-check-input" />
            <label asp-for="RequiereReserva" class="form-check-label">Requiere reserva</label>
        </div>
    </div>
</div>
