@model IEnumerable<Ruta>
@{
    ViewData["Title"] = "Rutas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">Rutas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva ruta</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control"
               placeholder="Buscar por nombre, lugar de origen, lugar de destino" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay registros para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Lugar de origen</th>
                    <th>Lugar de destino</th>
                    <th>Distancia (km)</th>
                    <th>Duración (minutos)</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.LugarOrigen?.Nombre</td>
                        <td>@item.LugarDestino?.Nombre</td>
                        <td>@Formato.Numero(item.DistanciaKilometros)</td>
                        <td>@item.DuracionMinutos</td>
                        <td>@Formato.SiNo(item.Activa)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.IdRuta" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdRuta" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdRuta" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Total: @Model.Count() registro(s)</p>
}
