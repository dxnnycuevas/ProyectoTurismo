@model Transporte
@{
    ViewData["Title"] = "Eliminar transporte";
}

<h2>Eliminar transporte</h2>
<hr />

<div class="alert alert-danger">¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de transporte</dt>
        <dd class="col-sm-8">@Model.TipoTransporte</dd>
        <dt class="col-sm-4">Zona de cobertura</dt>
        <dd class="col-sm-8">@Model.ZonaCobertura</dd>
        <dt class="col-sm-4">Requiere reserva</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.RequiereReserva)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdTransporte" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
