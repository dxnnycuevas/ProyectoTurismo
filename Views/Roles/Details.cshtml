@model Rol
@{
    ViewData["Title"] = "Detalle de rol";
}

<h2>Detalle de rol</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdRol" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
