@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        Iniciar sesión
                    </h2>

                    <p class="text-center text-muted">
                        Panel de administración
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    @* El tag helper del formulario agrega el token antifalsificación *@
                    <form asp-controller="Cuenta"
                          asp-action="Login"
                          asp-route-returnUrl="@ViewBag.ReturnUrl"
                          method="post"
                          autocomplete="off">

                        <div class="mb-3">
                            <label for="correo" class="form-label">
                                Correo electrónico
                            </label>

                            <input type="email"
                                   id="correo"
                                   name="correo"
                                   class="form-control"
                                   autocomplete="off"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="contrasena" class="form-label">
                                Contraseña
                            </label>

                            <input type="password"
                                   id="contrasena"
                                   name="contrasena"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Iniciar sesión
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
