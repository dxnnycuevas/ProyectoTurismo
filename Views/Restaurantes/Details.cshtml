@model Restaurante
@{
    ViewData["Title"] = "Detalle de restaurante";
}

<h2>Detalle de restaurante</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de comida</dt>
        <dd class="col-sm-8">@Model.TipoComida</dd>
        <dt class="col-sm-4">Nivel de precio</dt>
        <dd class="col-sm-8">@Formato.NivelPrecio(Model.NivelPrecio)</dd>
        <dt class="col-sm-4">Hora de apertura</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraApertura)</dd>
        <dt class="col-sm-4">Hora de cierre</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraCierre)</dd>
        <dt class="col-sm-4">Enlace del menú</dt>
        <dd class="col-sm-8">@if (!string.IsNullOrEmpty(Model.EnlaceMenu)) { <a href="@Model.EnlaceMenu" target="_blank" rel="noopener">@Model.EnlaceMenu</a> }</dd>
        <dt class="col-sm-4">Servicio a domicilio</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.ServicioDomicilio)</dd>
        <dt class="col-sm-4">Fecha de creación</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaCreacion)</dd>
        <dt class="col-sm-4">Última actualización</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaActualizacion)</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdRestaurante" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
