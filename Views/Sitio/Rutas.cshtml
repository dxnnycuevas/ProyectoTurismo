@model List<Ruta>
@{
    ViewData["Title"] = "Rutas";
    ViewData["Subtitulo"] = "Recorridos para conocer Jimaní y sus alrededores: distancia, tiempo, dificultad y cómo llegar.";
    ViewData["Descripcion"] = "Rutas turísticas recomendadas en Jimaní: distancia, duración, dificultad y cómo llegar.";
}

<section class="jm-seccion pt-4">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="jm-vacio jm-vidrio">
                <svg aria-hidden="true"><use href="#t-lago" /></svg>
                <h2 class="h4">Pronto publicaremos rutas</h2>
                <p class="mb-0">Mientras tanto, <a asp-action="Lugares">explora los destinos</a> o <a asp-controller="Asistente" asp-action="Index">pregúntale al asistente virtual</a> cómo llegar.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ruta in Model)
                {
                    <div class="col-md-6 col-lg-4 jm-revelar">
                        <partial name="_TarjetaRuta" model="ruta" />
                    </div>
                }
            </div>
        }
    </div>
</section>

<partial name="_BannerAsistente" />
