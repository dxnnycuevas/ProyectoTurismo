@model Restaurante

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="IdLugar" class="form-label">Lugar</label>
        <select asp-for="IdLugar" class="form-select" asp-items="ViewBag.ListaIdLugar">
            <option value="">-- Seleccione --</option>
        </select>
        @if (ViewBag.ListaIdLugar is SelectList listaIdLugar && !listaIdLugar.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugar" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TipoComida" class="form-label">Tipo de comida</label>
        <input asp-for="TipoComida" class="form-control" />
        <span asp-validation-for="TipoComida" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="NivelPrecio" class="form-label">Nivel de precio</label>
        <select asp-for="NivelPrecio" class="form-select">
            <option value="">-- Sin especificar --</option>
            <option value="1">$ (Económico)</option>
            <option value="2">$$ (Moderado)</option>
            <option value="3">$$$ (Alto)</option>
            <option value="4">$$$$ (Lujo)</option>
        </select>
        <span asp-validation-for="NivelPrecio" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HoraApertura" class="form-label">Hora de apertura</label>
        <input asp-for="HoraApertura" class="form-control" type="time" asp-format="{0:hh\:mm}" />
        <span asp-validation-for="HoraApertura" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HoraCierre" class="form-label">Hora de cierre</label>
        <input asp-for="HoraCierre" class="form-control" type="time" asp-format="{0:hh\:mm}" />
        <span asp-validation-for="HoraCierre" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="EnlaceMenu" class="form-label">Enlace del menú</label>
        <input asp-for="EnlaceMenu" class="form-control" type="url" placeholder="https://" />
        <span asp-validation-for="EnlaceMenu" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="ServicioDomicilio" class="form-check-input" />
            <label asp-for="ServicioDomicilio" class="form-check-label">Servicio a domicilio</label>
        </div>
    </div>
</div>
