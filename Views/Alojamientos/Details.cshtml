@model Alojamiento
@{
    ViewData["Title"] = "Detalle de alojamiento";
}

<h2>Detalle de alojamiento</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de alojamiento</dt>
        <dd class="col-sm-8">@Model.TipoAlojamiento</dd>
        <dt class="col-sm-4">Precio mínimo</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.PrecioMinimo)</dd>
        <dt class="col-sm-4">Precio máximo</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.PrecioMaximo)</dd>
        <dt class="col-sm-4">Cantidad de habitaciones</dt>
        <dd class="col-sm-8">@Model.CantidadHabitaciones</dd>
        <dt class="col-sm-4">Hora de entrada</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraEntrada)</dd>
        <dt class="col-sm-4">Hora de salida</dt>
        <dd class="col-sm-8">@Formato.Hora(Model.HoraSalida)</dd>
        <dt class="col-sm-4">Enlace de reserva</dt>
        <dd class="col-sm-8">@if (!string.IsNullOrEmpty(Model.EnlaceReserva)) { <a href="@Model.EnlaceReserva" target="_blank" rel="noopener">@Model.EnlaceReserva</a> }</dd>
        <dt class="col-sm-4">Fecha de creación</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaCreacion)</dd>
        <dt class="col-sm-4">Última actualización</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaActualizacion)</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdAlojamiento" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
