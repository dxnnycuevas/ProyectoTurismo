@model Alojamiento

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="IdLugar" class="form-label">Lugar</label>
        <select asp-for="IdLugar" class="form-select" asp-items="ViewBag.ListaIdLugar">
            <option value="">-- Seleccione --</option>
        </select>
        @if (ViewBag.ListaIdLugar is SelectList listaIdLugar && !listaIdLugar.Any())
        {
            <div class="form-text">No hay lugares disponibles. <a asp-controller="Lugares" asp-action="Create">Registrar un lugar</a></div>
        }
        <span asp-validation-for="IdLugar" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TipoAlojamiento" class="form-label">Tipo de alojamiento</label>
        <input asp-for="TipoAlojamiento" class="form-control" />
        <span asp-validation-for="TipoAlojamiento" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="PrecioMinimo" class="form-label">Precio mínimo</label>
        <input asp-for="PrecioMinimo" class="form-control" type="number" step="any" />
        <span asp-validation-for="PrecioMinimo" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="PrecioMaximo" class="form-label">Precio máximo</label>
        <input asp-for="PrecioMaximo" class="form-control" type="number" step="any" />
        <span asp-validation-for="PrecioMaximo" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="CantidadHabitaciones" class="form-label">Cantidad de habitaciones</label>
        <input asp-for="CantidadHabitaciones" class="form-control" type="number" min="0" />
        <span asp-validation-for="CantidadHabitaciones" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HoraEntrada" class="form-label">Hora de entrada</label>
        <input asp-for="HoraEntrada" class="form-control" type="time" asp-format="{0:hh\:mm}" />
        <span asp-validation-for="HoraEntrada" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="HoraSalida" class="form-label">Hora de salida</label>
        <input asp-for="HoraSalida" class="form-control" type="time" asp-format="{0:hh\:mm}" />
        <span asp-validation-for="HoraSalida" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="EnlaceReserva" class="form-label">Enlace de reserva</label>
        <input asp-for="EnlaceReserva" class="form-control" type="url" placeholder="https://" />
        <span asp-validation-for="EnlaceReserva" class="text-danger small"></span>
    </div>
</div>
