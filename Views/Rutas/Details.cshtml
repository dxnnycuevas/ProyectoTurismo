@model Ruta
@{
    ViewData["Title"] = "Detalle de ruta";
}

<h2>Detalle de ruta</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">Lugar de origen</dt>
        <dd class="col-sm-8">@Model.LugarOrigen?.Nombre</dd>
        <dt class="col-sm-4">Lugar de destino</dt>
        <dd class="col-sm-8">@Model.LugarDestino?.Nombre</dd>
        <dt class="col-sm-4">Distancia (km)</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.DistanciaKilometros)</dd>
        <dt class="col-sm-4">Duración (minutos)</dt>
        <dd class="col-sm-8">@Model.DuracionMinutos</dd>
        <dt class="col-sm-4">Nivel de dificultad</dt>
        <dd class="col-sm-8">@Model.NivelDificultad</dd>
        <dt class="col-sm-4">Tipo de transporte</dt>
        <dd class="col-sm-8">@Model.TipoTransporte</dd>
        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8"><span style="white-space:pre-line">@Model.Descripcion</span></dd>
        <dt class="col-sm-4">Instrucciones</dt>
        <dd class="col-sm-8"><span style="white-space:pre-line">@Model.Instrucciones</span></dd>
        <dt class="col-sm-4">Activa</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.Activa)</dd>
        <dt class="col-sm-4">Fecha de creación</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaCreacion)</dd>
        <dt class="col-sm-4">Última actualización</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaActualizacion)</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdRuta" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
