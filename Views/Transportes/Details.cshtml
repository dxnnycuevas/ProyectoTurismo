@model Transporte
@{
    ViewData["Title"] = "Detalle de transporte";
}

<h2>Detalle de transporte</h2>
<hr />

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de transporte</dt>
        <dd class="col-sm-8">@Model.TipoTransporte</dd>
        <dt class="col-sm-4">Zona de cobertura</dt>
        <dd class="col-sm-8">@Model.ZonaCobertura</dd>
        <dt class="col-sm-4">Horario</dt>
        <dd class="col-sm-8">@Model.Horario</dd>
        <dt class="col-sm-4">Información de precio</dt>
        <dd class="col-sm-8">@Model.InformacionPrecio</dd>
        <dt class="col-sm-4">Requiere reserva</dt>
        <dd class="col-sm-8">@Formato.SiNo(Model.RequiereReserva)</dd>
        <dt class="col-sm-4">Fecha de creación</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaCreacion)</dd>
        <dt class="col-sm-4">Última actualización</dt>
        <dd class="col-sm-8">@Formato.Fecha(Model.FechaActualizacion)</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.IdTransporte" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
