@model Alojamiento
@{
    ViewData["Title"] = "Eliminar alojamiento";
}

<h2>Eliminar alojamiento</h2>
<hr />

<div class="alert alert-danger">¿Está seguro de que desea eliminar este registro? Esta acción no se puede deshacer.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar?.Nombre</dd>
        <dt class="col-sm-4">Tipo de alojamiento</dt>
        <dd class="col-sm-8">@Model.TipoAlojamiento</dd>
        <dt class="col-sm-4">Precio mínimo</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.PrecioMinimo)</dd>
        <dt class="col-sm-4">Precio máximo</dt>
        <dd class="col-sm-8">@Formato.Numero(Model.PrecioMaximo)</dd>
        <dt class="col-sm-4">Cantidad de habitaciones</dt>
        <dd class="col-sm-8">@Model.CantidadHabitaciones</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdAlojamiento" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
